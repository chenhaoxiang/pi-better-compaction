{
  "name": "@lll9p/pi-better-compaction",
  "version": "0.7.4-fork.5",
  "type": "module",
  "description": "Better compaction for pi: native /responses/compact replay for OpenAI Responses APIs, Anthropic server-side compaction, plus a configurable compaction model driving pi's native summarization everywhere else.",
  "author": "Lilin Lao",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenhaoxiang/pi-better-compaction.git"
  },
  "bugs": {
    "url": "https://github.com/chenhaoxiang/pi-better-compaction/issues"
  },
  "homepage": "https://github.com/chenhaoxiang/pi-better-compaction#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "openai",
    "anthropic",
    "compaction",
    "codex",
    "responses"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "src/anthropic-compaction.ts",
    "src/compact-client.ts",
    "src/compact-client-v2.ts",
    "src/config.ts",
    "src/debug.ts",
    "src/details-store.ts",
    "src/diagnostics.ts",
    "src/extension-runtime.ts",
    "src/model-candidates.ts",
    "src/native-fallback.ts",
    "src/portable-history.ts",
    "src/portable-summary.ts",
    "src/payload-rewrite.ts",
    "src/request-context-cache.ts",
    "src/retained-messages.ts",
    "src/runtime.ts",
    "src/serializer.ts",
    "src/shared-headers.ts",
    "src/supported-environment.ts",
    "src/types.ts",
    "src/usage.ts",
    "README.md",
    "README.zh-CN.md",
    "docs/releasing.md",
    "docs/maintenance/2026-10-21-sdk-baseline.md",
    "docs/maintenance/2026-10-22-pi14-release.md",
    "docs/compaction-diagnostics.md",
    "docs/maintenance/2026-10-10-community-0.7.4.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-dir=tmp/coverage && node ./scripts/check-lcov.mjs ./tmp/coverage/lcov.info --baseline ./test/coverage-baseline.json",
    "test:pi": "bun test ./test/pi-smoke.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": ">=1.3.0-fork.1"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "https://github.com/chenhaoxiang/pi/releases/download/v1.3.0-fork.1/earendil-works-pi-agent-core-1.3.0-fork.1.tgz",
    "@earendil-works/pi-ai": "https://github.com/chenhaoxiang/pi/releases/download/v1.3.0-fork.1/earendil-works-pi-ai-1.3.0-fork.1.tgz",
    "@earendil-works/pi-coding-agent": "https://github.com/chenhaoxiang/pi/releases/download/v1.3.0-fork.1/earendil-works-pi-coding-agent-1.3.0-fork.1.tgz"
  },
  "overrides": {
    "@earendil-works/pi-agent-core": "https://github.com/chenhaoxiang/pi/releases/download/v1.3.0-fork.1/earendil-works-pi-agent-core-1.3.0-fork.1.tgz",
    "@earendil-works/pi-ai": "https://github.com/chenhaoxiang/pi/releases/download/v1.3.0-fork.1/earendil-works-pi-ai-1.3.0-fork.1.tgz",
    "@earendil-works/pi-codemode": "https://github.com/chenhaoxiang/pi/releases/download/v1.3.0-fork.1/earendil-works-pi-codemode-1.3.0-fork.1.tgz",
    "@earendil-works/pi-mcp": "https://github.com/chenhaoxiang/pi/releases/download/v1.3.0-fork.1/earendil-works-pi-mcp-1.3.0-fork.1.tgz",
    "@earendil-works/pi-telemetry": "https://github.com/chenhaoxiang/pi/releases/download/v1.3.0-fork.1/earendil-works-pi-telemetry-1.3.0-fork.1.tgz",
    "@earendil-works/pi-tui": "https://github.com/chenhaoxiang/pi/releases/download/v1.3.0-fork.1/earendil-works-pi-tui-1.3.0-fork.1.tgz"
  }
}
